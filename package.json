{
  "name": "@zeromodern/agentkit-provider-0mod",
  "version": "1.4.0",
  "description": "Coinbase AgentKit action provider for the 0mod API Gateway",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "build"
  ],
  "publishConfig": {
